VISION_ENVIRONMENT=development
VISION_SOURCE=sentinel2_stac
VISION_BIND_HOST=127.0.0.1
VISION_BIND_PORT=8080
VISION_POLL_INTERVAL_SECONDS=21600
VISION_MIN_REQUEST_SPACING_SECONDS=15
VISION_HOURLY_REQUEST_BUDGET=12
VISION_DAILY_REQUEST_BUDGET=120
VISION_SENTINEL_LOOKBACK_DAYS=45
VISION_SENTINEL_MAX_CLOUD_COVER=30
VISION_AOI_WEST=24.80
VISION_AOI_SOUTH=60.10
VISION_AOI_EAST=25.20
VISION_AOI_NORTH=60.35
VISION_DATA_DIR=./data
VISION_DB_PATH=./data/geospatial.db
VISION_MODEL_DIR=./models
VISION_REPORTS_DIR=./reports
# Optional: set a high-entropy secret to authenticate the local audit-chain digest.
# VISION_AUDIT_HMAC_KEY=
